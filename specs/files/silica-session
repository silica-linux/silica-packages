#!/bin/sh
# silica-session: the Silica Wayland session, started by the login manager from
# /usr/share/wayland-sessions/silica.desktop. Ossido on DRM/KMS (seat from logind or seatd)
# with the shell components; the list mirrors silica-desktop's `cargo xtask run --shell`
# (xtask/src/main.rs, shell_component_args).
#
# Configuration: /etc/silica/session.env, then /etc/silica/session.env.d/*.env (shell
# variable assignments, exported; silica-os drops its own files there):
#   SILICA_RENDERER  renderer of the Flutter embedder: vulkan (default, falls back to GL),
#                    gl, impeller or software (virtual machines without 3D)
#   SILICA_BACKEND   Ossido backend (default: drm, or winit when started inside another
#                    Wayland or X11 session)
#   OSSIDO_ARGS      extra arguments for Ossido, split on spaces (e.g. `--control 7991`)
#   SILICA_PREFIX    development: a tree with bin/, engine/, shell/ and optionally share/
#                    and icons/ (silica-desktop's `cargo xtask os deploy`) used instead of
#                    the installed session
#
# The seat comes from libseat: logind in a login manager session (greetd, GDM, SDDM), seatd
# where it runs.

set -a
for env in /etc/silica/session.env /etc/silica/session.env.d/*.env; do
  # shellcheck disable=SC1090
  [ -r "$env" ] && . "$env"
done
set +a
export SILICA_RENDERER="${SILICA_RENDERER:-vulkan}"
# The apps take their symbols from silica-icons: the installed copy unless a dev tree or
# the session environment says otherwise.
export SILICA_ICONS_DIR="${SILICA_ICONS_DIR:-/usr/share/silica/icons}"

export XDG_CURRENT_DESKTOP=Silica
export XDG_SESSION_DESKTOP=silica
export XDG_SESSION_TYPE=wayland
# Ossido loads the Adwaita XCursor theme (adwaita-cursor-theme).
export XCURSOR_THEME="${XCURSOR_THEME:-Adwaita}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
# silica-daemon, silica-portal and the embedder live in libexec: Ossido looks for the
# services next to its own binary, then in PATH.
export PATH="@LIBEXECDIR@/silica:$PATH"

embedder="@LIBEXECDIR@/silica/silica-app"
bundle="@LIBDIR@/silica/shell/flutter_assets"
ossido=/usr/bin/ossido
if [ -n "$SILICA_PREFIX" ] && [ -x "$SILICA_PREFIX/bin/ossido" ]; then
  # silica-app reads SILICA_PREFIX too: the apps run on the same embedder and engine.
  export SILICA_PREFIX
  export PATH="$SILICA_PREFIX/bin:$PATH"
  export XDG_DATA_DIRS="$SILICA_PREFIX/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  [ -d "$SILICA_PREFIX/icons" ] && export SILICA_ICONS_DIR="$SILICA_PREFIX/icons"
  bundle="$SILICA_PREFIX/shell/flutter_assets"
  ossido="$SILICA_PREFIX/bin/ossido"
fi

set -- \
  --spawn-shell "$embedder --layer background --anchor top,bottom,left,right --size 1280x800 --exclusive-zone -1 --namespace wallpaper --dart-arg wallpaper $bundle" \
  --spawn-shell "$embedder --layer top --anchor top,left,right --size 1280x30 --exclusive-zone 30 --namespace menubar --dart-arg menubar $bundle" \
  --spawn-shell "$embedder --layer top --anchor left,right,bottom --size 1280x200 --exclusive-zone 84 --namespace dock --dart-arg dock $bundle" \
  --spawn-shell "$embedder --layer overlay --anchor top,bottom,left,right --size 1280x800 --keyboard none --namespace faro --dart-arg faro $bundle" \
  --spawn-shell "$embedder --layer overlay --anchor top,bottom,left,right --size 1280x800 --exclusive-zone -1 --keyboard none --namespace switcher --dart-arg switcher $bundle" \
  --spawn-shell "$embedder --layer overlay --anchor top,bottom,left,right --size 1280x800 --exclusive-zone -1 --keyboard none --namespace notifications --dart-arg notifications $bundle" \
  --spawn-shell "$embedder --layer overlay --anchor top,bottom,left,right --size 1280x800 --exclusive-zone -1 --keyboard none --namespace controlcenter --dart-arg controlcenter $bundle"

# The file manager's desktop (silica-desktop#147): Mustache's --desktop mode on the bottom
# layer, above the wallpaper and below the windows, kept running by Ossido.
desktop="@LIBDIR@/silica/apps/dev.frascella.Mustache/flutter_assets"
if [ -n "$SILICA_PREFIX" ] && [ -d "$SILICA_PREFIX/apps/dev.frascella.Mustache/flutter_assets" ]; then
  desktop="$SILICA_PREFIX/apps/dev.frascella.Mustache/flutter_assets"
fi
if [ -d "$desktop" ]; then
  set -- "$@" \
    --keep-shell "$embedder --layer bottom --anchor top,bottom,left,right --size 1280x800 --exclusive-zone -1 --keyboard on-demand --namespace desktop-icons:dev.frascella.Mustache --dart-arg --desktop $desktop"
fi

if [ -n "$SILICA_BACKEND" ]; then
  set -- --backend "$SILICA_BACKEND" "$@"
fi

if [ -n "$DBUS_SESSION_BUS_ADDRESS" ]; then
  # A login session has its user bus: silica-daemon takes the notification names on it, and
  # D-Bus activation (the portal, the mail engine) learns the Wayland socket once Ossido has
  # it (Ossido passes WAYLAND_DISPLAY to what it spawns).
  set -- "$@" \
    --spawn "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XCURSOR_THEME XCURSOR_SIZE" \
    --spawn "silica-daemon --replace"
else
  # No user bus (a bare TTY or seatd-launch): Ossido starts a private one with
  # silica-daemon and silica-portal on it.
  set -- --session-bus "$@"
fi

# shellcheck disable=SC2086
exec "$ossido" $OSSIDO_ARGS "$@"
